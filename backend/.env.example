# AnonChat Backend Environment Configuration
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Security Secrets (Must be changed in production)
JWT_SECRET=anonchat_production_jwt_secret_replace_with_64_char_random_hex
JWT_EXPIRES_IN=30d

# Database Storage Path (SQLite)
DB_PATH=./data/anonchat.db

# Subscription & Licensing
TRIAL_DURATION_DAYS=7

# Initial Bootstrap Administrator (Enforced role: admin)
ADMIN_INITIAL_ID=ADM-MASTER-01
ADMIN_INITIAL_PASSWORD=ChangeMeImmediatelyOnFirstLogin2026!

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://127.0.0.1:5500
