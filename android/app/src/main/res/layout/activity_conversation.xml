<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <!-- Compatibility hidden toolbar to keep ActionBar references safe -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- 1. Top Header Bar: Back Button + Recipient Avatar + Name/Status + Call Button -->
    <LinearLayout
        android:id="@+id/ll_chat_custom_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:background="@color/dark_background">

        <!-- Back Button (Circular Dark Neumorphic Button) -->
        <FrameLayout
            android:id="@+id/btn_chat_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_button_dark"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="?attr/homeAsUpIndicator"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />
        </FrameLayout>

        <!-- Recipient Circular Avatar -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/tv_chat_avatar_initial"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="U"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Recipient Name -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_chat_recipient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kathy Gomez"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtle Security Notice (Sleek Dark Pill) -->
    <LinearLayout
        android:id="@+id/banner_security_disclosure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1B1D22"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_lock"
            app:tint="#FF4D4D"
            android:contentDescription="Shield" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Curve25519 E2EE &amp; 7-Day Auto-Purge Protected"
            android:textSize="11sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>

    <!-- Date Divider Chip: "Today" -->
    <TextView
        android:id="@+id/tv_date_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:text="Today"
        android:textSize="12sp"
        android:textColor="#6B7280" />

    <!-- 2. Message History List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:background="@color/dark_background" />

    <!-- Expired Subscription Block Banner -->
    <LinearLayout
        android:id="@+id/container_trial_expired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1D22"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trial_expired_notice"
            android:textStyle="bold"
            android:textColor="@color/danger"
            android:gravity="center"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_activate_from_chat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/activate_license_btn"
            android:textAllCaps="false"
            app:backgroundTint="#FF4D4D"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- 3. Floating Bottom Message Input Bar (Matching Screen 2) -->
    <LinearLayout
        android:id="@+id/container_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:paddingTop="6dp"
        android:background="@color/dark_background">

        <!-- Dark Rounded Pill Input Box -->
        <LinearLayout
            android:id="@+id/ll_input_box"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <!-- Emoji Button -->
            <ImageView
                android:id="@+id/btn_emoji"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:src="@drawable/ic_mood"
                app:tint="#FF4D4D"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Emoji" />

            <!-- Text Input -->
            <EditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@null"
                android:hint="@string/type_message_hint"
                android:textColorHint="#6B7280"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:singleLine="true" />

            <!-- Paperclip Media Attachment -->
            <ImageView
                android:id="@+id/btn_attach_media"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="5dp"
                android:src="@drawable/ic_attach"
                app:tint="#9CA3AF"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Attach Image or Video" />

            <!-- Camera Capture Button -->
            <ImageView
                android:id="@+id/btn_camera_capture"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:padding="5dp"
                android:src="@drawable/ic_camera"
                app:tint="#FF4D4D"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Camera" />
        </LinearLayout>

        <!-- Large Floating Send / Mic Button (Coral Red) -->
        <FrameLayout
            android:id="@+id/btn_send_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_button_coral"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/iv_send_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mic"
                app:tint="#FFFFFF"
                android:contentDescription="@string/send" />

            <!-- Hidden FAB to maintain exact backward compatibility -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_send_message"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                android:contentDescription="@string/send" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
