<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <!-- Compatibility hidden toolbar to keep ActionBar references safe -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- 1. Top Modern Chatbot Header Bar -->
    <LinearLayout
        android:id="@+id/ll_chat_custom_header"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:background="#131926">

        <!-- Back Button (Circular Dark Button) -->
        <FrameLayout
            android:id="@+id/btn_chat_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_button_dark"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="?attr/homeAsUpIndicator"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />
        </FrameLayout>

        <!-- Recipient Circular Avatar -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_chat_avatar_initial"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:text="P"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Recipient Name & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_chat_recipient_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prime Encrypted Chat"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_unread_pill"
                    android:backgroundTint="#10B981" />

                <TextView
                    android:id="@+id/tv_chat_status_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Online • E2EE Encrypted"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shield Security Info Action -->
        <FrameLayout
            android:id="@+id/banner_security_disclosure"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_button_dark"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock"
                app:tint="#6366F1"
                android:contentDescription="Security Info" />
        </FrameLayout>

        <!-- 3-Dots More Options Menu Button -->
        <FrameLayout
            android:id="@+id/btn_chat_menu"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_circle_button_dark"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_more_vert"
                app:tint="#FFFFFF"
                android:contentDescription="Chat Options" />
        </FrameLayout>
    </LinearLayout>

    <!-- Subtle Privacy / E2EE Info Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#0E131F"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_lock"
            app:tint="#06B6D4"
            android:contentDescription="Shield" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="NIST P-256 E2EE • Zero-Knowledge • 7-Day Purge"
            android:textSize="10sp"
            android:textColor="#64748B" />
    </LinearLayout>

    <!-- 2. Message History Stream -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="@color/dark_background" />

    <!-- Expired Subscription Block Banner -->
    <LinearLayout
        android:id="@+id/container_trial_expired"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1B1D22"
        android:padding="16dp"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trial_expired_notice"
            android:textStyle="bold"
            android:textColor="@color/danger"
            android:gravity="center"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_activate_from_chat"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/activate_license_btn"
            android:textAllCaps="false"
            app:backgroundTint="#6366F1"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- 3. Modern Floating Chatbot Prompt Bar -->
    <LinearLayout
        android:id="@+id/container_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:paddingTop="6dp"
        android:background="@color/dark_background">

        <!-- Modern Rounded Floating Input Pill -->
        <LinearLayout
            android:id="@+id/ll_input_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="@drawable/bg_input_rounded"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Attach Media / Image Button (+) -->
            <ImageView
                android:id="@+id/btn_attach_media"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:src="@drawable/ic_attach"
                app:tint="#94A3B8"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Attach Image or Video" />

            <!-- Clean Text Input Field -->
            <EditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="@null"
                android:hint="Message..."
                android:textColorHint="#64748B"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:maxLines="4" />

            <!-- Circular Send Button -->
            <FrameLayout
                android:id="@+id/btn_send_container"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_button_coral"
                android:backgroundTint="@color/primary"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_send_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:tint="#FFFFFF"
                    android:contentDescription="@string/send" />

                <!-- Hidden FAB for backward compatibility -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btn_send_message"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"
                    android:contentDescription="@string/send" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Messages are protected by Curve25519 &amp; auto-purge"
            android:textSize="10sp"
            android:textColor="#475569" />
    </LinearLayout>

</LinearLayout>
