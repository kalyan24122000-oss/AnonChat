<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <!-- Compatibility hidden toolbar to keep ActionBar references safe -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 1. Top Header Bar: Profile Avatar + "Prime Chat" Title + New Chat (+) Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="12dp"
                android:background="#131926">

                <!-- User Profile Avatar (Clickable to open profile/settings) -->
                <FrameLayout
                    android:id="@+id/btn_user_profile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/bg_circle_button_dark">

                    <TextView
                        android:id="@+id/tv_header_avatar_initial"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_avatar_circle"
                        android:gravity="center"
                        android:text="U"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- App Title: "Prime Chat" -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_header_chats_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="End-to-End Encrypted Messaging"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- New Chat / Find Users Button (+) -->
                <FrameLayout
                    android:id="@+id/btn_header_add_chat"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_circle_button_coral"
                    android:backgroundTint="@color/primary"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="#FFFFFF"
                        android:contentDescription="New Chat" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. Search Bar: Deep Sunken Dark Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_search_pill_sunken"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="#64748B"
                    android:contentDescription="Search" />

                <EditText
                    android:id="@+id/et_search_chats"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@null"
                    android:hint="Search chats or user ID..."
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <!-- 3. Trial / Subscription Status Banner (Soft Dark Card) -->
            <LinearLayout
                android:id="@+id/banner_subscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="8dp"
                android:padding="10dp"
                android:background="@drawable/bg_media_card"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_subscription_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_shield"
                    app:tint="@color/primary"
                    android:contentDescription="Status" />

                <TextView
                    android:id="@+id/tv_subscription_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="7 days remaining in trial"
                    android:textSize="12sp"
                    android:textColor="#E5E7EB" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_banner_activate"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Activate"
                    android:textSize="11sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    app:cornerRadius="16dp"
                    app:backgroundTint="@color/primary" />
            </LinearLayout>

            <!-- 4. Conversations List Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipe_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_conversations"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:paddingBottom="84dp" />

                        <!-- Genuine Chatting App Empty State -->
                        <LinearLayout
                            android:id="@+id/ll_empty_state"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="32dp"
                            android:visibility="gone">

                            <FrameLayout
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:background="@drawable/bg_circle_button_dark">

                                <ImageView
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_chats"
                                    app:tint="@color/primary"
                                    android:contentDescription="No Chats" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="No conversations yet"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#FFFFFF" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Find another user by their USR ID to start an encrypted private chat."
                                android:gravity="center"
                                android:textSize="13sp"
                                android:textColor="#9CA3AF" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_empty_start_chat"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:layout_marginTop="20dp"
                                android:text="Find Users to Chat"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                app:cornerRadius="22dp"
                                app:backgroundTint="@color/primary" />
                        </LinearLayout>
                    </FrameLayout>
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </FrameLayout>

            <!-- Footer Branding -->
            <TextView
                android:id="@+id/tv_footer_branding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="PRIME CHAT • END-TO-END ENCRYPTED"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#475569" />

        </LinearLayout>

        <!-- 5. Floating Bottom Navigation Dock (Chats & Settings) -->
        <LinearLayout
            android:id="@+id/ll_bottom_dock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="44dp"
            android:layout_marginEnd="44dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_dock_bar"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <!-- Tab 1: Chats (Active Pill) -->
            <FrameLayout
                android:id="@+id/tab_chats"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_tab_active_coral"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chats"
                        app:tint="#FFFFFF"
                        android:contentDescription="Chats" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Chats"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Tab 2: Settings -->
            <FrameLayout
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_tab_inactive_dark"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_settings"
                        app:tint="#94A3B8"
                        android:contentDescription="Settings" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Settings"
                        android:textColor="#94A3B8"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Hidden FloatingActionButton for backward compatibility -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_new_chat"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="New Chat" />

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
