<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_blocked"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="@string/blocked_users"
        app:titleTextColor="@color/background_white"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/background_white" />

    <ProgressBar
        android:id="@+id/progress_blocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_no_blocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="No users currently blocked."
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_blocked_users"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
